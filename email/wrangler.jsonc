{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inflite-email",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // Serves the web app from ./public; /api/* runs the Worker, and so does Mail's page (/ and /index.html), whose
  // Content-Security-Policy the Worker puts in place of public/_headers' one, with frame-ancestors HUB_ORIGIN (below).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // (and, for InFlite's page, One roof stage 4: /body and /body/* Mail's body shell, src/body.js; /roof/* the module's
    // files, which must 404 when missing rather than fall back to the page)
    "run_worker_first": ["/api/*", "/", "/index.html", "/body", "/body/*", "/roof/*"]
  },

  "routes": [{ "pattern": "email.inflite.ai", "custom_domain": true }],

  // Created automatically on first deploy.
  "d1_databases": [{ "binding": "DB" }],
  "r2_buckets": [{ "binding": "MAIL" }],

  // Cloudflare Email Service (Email Sending).
  "send_email": [{ "name": "EMAIL" }],

  // (the account's address asked through the inflite-apps Worker directly, not through a fetch, which skips the
  // zone's Worker routes: src/apps.js)
  "services": [{ "binding": "APPS", "service": "inflite-apps" }],

  // Signing in is the inflite account's; sent mail goes out under the account's name. HUB_ORIGIN: InFlite's window and
  // its staging hub (a space between them), whose /mail/ pages are the only pages that may frame Mail (Today First; the
  // root Worker's today/src/mailhost.js; the staging hub at next.inflite.ai is the root Worker's [env.next]).
  "vars": {
    "DOMAIN": "inflite.ai",
    "DEFAULT_FROM": "hello@inflite.ai",
    "ACCOUNT_ORIGIN": "https://account.inflite.ai",
    "HUB_ORIGIN": "https://inflite.ai https://next.inflite.ai"
  },

  "triggers": { "crons": ["*/5 * * * *"] },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
